      m_Calls: []
  m_text: "\u201CI was on my way to the captain's cabinet, and as I entered the cabinet,
    I saw a pool of blood and      laying on top of it. As I was inspecting the scene,
    I heard a woman screaming \u201CMurderer!!\u201D, I swear I didn\u2019t do it,
    I was in the wrong place, at the wrong time.\u201D"
  m_isRightToLeft: 0
